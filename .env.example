# URL publica. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gere uma string longa e aleatoria. Ex.: openssl rand -base64 48
SESSION_SECRET=

# Discord OAuth2 (Developer Portal -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Token do MESMO bot BlackDz Community. NUNCA coloque NEXT_PUBLIC_ neste token.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1519101675703369778
OWNER_DISCORD_ID=1345387246282608751

# PostgreSQL/Neon. O site publico funciona sem DB, mas assinaturas/admin precisam dele.
DATABASE_URL=

# demo | picpay
PAYMENTS_MODE=demo

# PicPay Checkout / Recorrencia
# Sandbox por padrao. Em producao use as URLs informadas no seu Painel/Documentacao PicPay.
PICPAY_ENV=sandbox
PICPAY_CLIENT_ID=
PICPAY_CLIENT_SECRET=
PICPAY_AUTH_URL=https://ecommerce-api.svcp.ppay.me/oauth2/token
PICPAY_RECURRENCY_BASE_URL=https://ecommerce-api.svcp.ppay.me/recurrency/sandbox/v1
# Token que o PicPay gera ao configurar a URL de webhook
PICPAY_WEBHOOK_TOKEN=
# Usado somente pelo SDK no navegador, conforme a documentacao oficial do PicPay.
NEXT_PUBLIC_PICPAY_MERCHANT_CREDENTIAL=
NEXT_PUBLIC_PICPAY_TRANSPARENT_TOKEN=
# Quantas mensalidades o plano criado no PicPay tera (ex.: 120 = 10 anos)
PICPAY_TOTAL_BILLING_CYCLES=120

# Opcional: se definido, Vercel Cron envia Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Links publicos opcionais
NEXT_PUBLIC_DISCORD_INVITE_URL=
NEXT_PUBLIC_CURSEFORGE_URL=https://www.curseforge.com/minecraft/mc-mods/dbc-blackdz-expanded
